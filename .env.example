# Asterisk AMI endpoint and relay-local credentials.
RELAY_AMI_HOST=asterisk
RELAY_AMI_PORT=5038
RELAY_AMI_USERNAME=replace-with-ami-username
RELAY_AMI_PASSWORD=replace-with-ami-password

# Shared secret configured on the Grafana webhook Contact Point for HMAC-SHA256.
RELAY_WEBHOOK_HMAC_SECRET=replace-with-a-long-random-secret
RELAY_WEBHOOK_SIGNATURE_HEADER=X-Grafana-Alerting-Signature

# HTTP listener.
# A single AF_INET6 socket accepting both IPv6 and IPv4 connections.
RELAY_LISTEN_HOST=::
RELAY_LISTEN_PORT=8080

# Request and AMI session limits.
RELAY_MAX_BODY_BYTES=65536
RELAY_MAX_ACTION_ID_BYTES=256
RELAY_WRITE_QUEUE_SIZE=100
RELAY_CONNECT_TIMEOUT=5
RELAY_LOGIN_TIMEOUT=5
RELAY_WRITE_TIMEOUT=5
RELAY_SUBMIT_TIMEOUT=10
RELAY_PENDING_TIMEOUT=300
RELAY_RECONNECT_MIN_DELAY=1
RELAY_RECONNECT_MAX_DELAY=30
